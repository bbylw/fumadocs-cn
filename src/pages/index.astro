---
import Layout from '@/layouts/Layout.astro';
import { docsRoute } from '@/lib/shared';

const githubUrl = 'https://github.com/bbylw/fumadocs-cn';
const upstreamUrl = 'https://github.com/fuma-nama/fumadocs';

const features = [
  {
    title: '极简',
    en: 'Minimal',
    desc: '专注把基础做到完美。没有黑盒配置，逻辑透明、可维护、好拆解。',
  },
  {
    title: '服务端优先',
    en: 'Server-first',
    desc: 'React Server Component 驱动，服务端与客户端边界清晰，内容动态且可交互。',
  },
  {
    title: '可组合的 UI',
    en: 'Composable UI',
    desc: '默认主题开箱即用，通过 Fumadocs CLI 分叉组件，完全可定制（Shadcn 风格）。',
  },
  {
    title: '无缝集成',
    en: 'Seamless',
    desc: '与 Astro 7 / React 19 紧密集成，熟悉的静态生成体验，零学习成本上手。',
  },
  {
    title: '一键搜索',
    en: 'Instant Search',
    desc: '基于 Orama 的本地全文搜索，Fuzzy 匹配、键盘导航，静态托管也能用。',
  },
  {
    title: '为 AI 而生',
    en: 'AI-ready',
    desc: 'LLMs.txt、Markdown 接口、结构化数据输出，让文档被大模型准确引用。',
  },
];

const layers = [
  { name: 'Fumadocs Core', desc: '搜索、内容源适配器、Markdown 扩展', tag: 'HEADLESS' },
  { name: 'Fumadocs UI', desc: '默认主题：美观交互与文档级组件', tag: 'THEME' },
  { name: '内容源', desc: 'MDX 本地层，也可接 CMS / 远程数据', tag: 'SOURCE' },
  { name: 'Fumadocs CLI', desc: '安装组件、自动化处理、任意分叉', tag: 'CLI' },
];

const docSections = [
  { href: '/docs/', title: '快速开始', desc: '3 分钟初始化第一个文档站' },
  { href: '/docs/what-is-fumadocs', title: '什么是 Fumadocs', desc: '设计理念与何时使用' },
  { href: '/docs/manual-installation', title: '手动安装', desc: '集成到已有 Astro / React 仓库' },
  { href: '/docs/page-conventions', title: '页面与页面树', desc: 'Slug、meta.json 与路由约定' },
  { href: '/docs/ui/', title: 'UI 默认主题', desc: '组件、主题与文档布局' },
  { href: '/docs/integrations/llms', title: 'AI 与 LLM 集成', desc: 'llms.txt 与结构化输出' },
];
---

<Layout
  title="Fumadocs 中文文档 — 一个可拆解的文档框架 | Astro + Bun"
  description="Fumadocs（Foo-ma docs）是快速、灵活、可拆解的文档框架。本站基于 Astro 7 + Fumadocs 16 + Bun 1.4 构建，提供精美落地页与完整中文文档。"
>
  <main class="landing-hero text-zinc-100">
    <!-- 顶部导航 -->
    <header class="mx-auto max-w-6xl px-5 pt-6">
      <nav class="glass flex items-center justify-between rounded-2xl px-4 py-3 sm:px-5" aria-label="主导航">
        <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
          <span class="grid size-8 place-items-center rounded-xl bg-gradient-to-br from-violet-500 to-blue-500 text-sm" aria-hidden="true">F</span>
          <span>Fumadocs <span class="text-zinc-400 font-normal">中文文档</span></span>
          <span class="hidden rounded-full border border-white/10 px-2 py-0.5 text-[11px] text-zinc-400 sm:inline">v2.0 Astro 版</span>
        </a>
        <div class="flex items-center gap-1 text-sm text-zinc-300 sm:gap-2">
          <a class="rounded-lg px-3 py-1.5 hover:bg-white/5 hover:text-white" href="/docs/">文档</a>
          <a class="hidden rounded-lg px-3 py-1.5 hover:bg-white/5 hover:text-white sm:inline" href="/docs/comparisons">对比</a>
          <a class="hidden rounded-lg px-3 py-1.5 hover:bg-white/5 hover:text-white sm:inline" href="/docs/what-is-fumadocs">概念</a>
          <a class="rounded-full bg-white px-3.5 py-1.5 font-medium text-zinc-950 hover:bg-zinc-200" href="/docs/">快速开始 →</a>
        </div>
      </nav>
    </header>

    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-5 pb-16 pt-14 sm:pt-20">
      <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-zinc-300">
            <span class="size-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
            最新栈：Astro 7.4.13 · Fumadocs 16.19.4 · React 19 · Bun 1.4.5
          </p>
          <h1 class="mt-5 text-4xl font-bold leading-[1.12] tracking-tight sm:text-6xl">
            一个<span class="bg-gradient-to-r from-violet-300 via-white to-blue-300 bg-clip-text text-transparent">可拆解</span>的<br />
            文档框架
          </h1>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-zinc-400 sm:text-lg">
            快速、灵活，无缝组合进你的 Astro + React 项目。极简抽象、服务端优先、可组合 UI —— 写代码，而不是配配置。
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="/docs/" class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-zinc-950 shadow-lg shadow-white/10 hover:bg-zinc-200">
              开始阅读文档 →
            </a>
            <a href="/docs/what-is-fumadocs" class="rounded-full border border-white/15 px-6 py-3 text-sm font-medium text-white hover:bg-white/5">
              什么是 Fumadocs
            </a>
            <a href={upstreamUrl} class="text-sm text-zinc-400 underline-offset-4 hover:text-white hover:underline" target="_blank" rel="noreferrer">
              官方 GitHub ↗
            </a>
          </div>
          <dl class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm">
            <div>
              <dt class="text-2xl font-bold">17 篇</dt>
              <dd class="text-zinc-500">完整中文文档</dd>
            </div>
            <div>
              <dt class="text-2xl font-bold">3 分钟</dt>
              <dd class="text-zinc-500">从初始化到部署</dd>
            </div>
            <div>
              <dt class="text-2xl font-bold">100%</dt>
              <dd class="text-zinc-500">静态生成 · 可托管 CDN</dd>
            </div>
          </dl>
          <!-- 技术栈徽章 -->
          <ul class="mt-8 flex flex-wrap gap-2 text-[12px] text-zinc-400" aria-label="技术栈">
            <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1">Astro 7</li>
            <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1">Fumadocs 16</li>
            <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1">React 19</li>
            <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1">Bun 1.4</li>
            <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1">Tailwind 4</li>
            <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1">MDX</li>
            <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1">Orama Search</li>
          </ul>
        </div>

        <!-- 代码窗口 -->
        <div class="float-y">
          <div class="code-window overflow-hidden rounded-2xl">
            <div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
              <div class="flex gap-1.5" aria-hidden="true">
                <span class="size-3 rounded-full bg-[#ff5f57]"></span>
                <span class="size-3 rounded-full bg-[#febc2e]"></span>
                <span class="size-3 rounded-full bg-[#28c840]"></span>
              </div>
              <span class="text-xs text-zinc-500">快速开始 — Bun</span>
              <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-[11px] text-emerald-300">bun run dev</span>
            </div>
            <pre class="overflow-auto p-5 text-[13px] leading-6"><code><span class="text-zinc-500"># 初始化（Astro 模板）</span>
<span class="text-violet-300">bunx</span> <span class="text-zinc-100">create-fumadocs-app</span>
<span class="text-zinc-500"># 安装依赖（极速）</span>
<span class="text-violet-300">bun</span> <span class="text-zinc-100">install</span>
<span class="text-zinc-500"># 本地预览</span>
<span class="text-violet-300">bun</span> <span class="text-zinc-100">run dev</span>
<span class="text-zinc-500"># 构建静态站</span>
<span class="text-violet-300">bun</span> <span class="text-zinc-100">run build</span>

<span class="text-zinc-500">// content/docs/index.mdx</span>
<span class="text-blue-300">---</span>
<span class="text-zinc-100">title</span><span class="text-zinc-500">:</span> <span class="text-amber-200">快速开始</span>
<span class="text-blue-300">---</span>

<span class="text-zinc-100">## 写文档，就是写 Markdown</span>
<span class="text-emerald-300">欢迎</span><span class="text-zinc-100">来到 Fumadocs + Astro。</span></code></pre>
            <div class="flex items-center justify-between border-t border-white/10 px-4 py-3 text-xs text-zinc-500">
              <span>在 docs 文件夹新建 .mdx 即可</span>
              <a href="/docs/" class="text-blue-300 hover:underline">打开全部文档 ↗</a>
            </div>
          </div>
          <p class="mt-3 text-center text-xs text-zinc-600">要求 Bun 1.4+（或 Node 22+）· 构建产物位于 <code class="rounded bg-white/5 px-1">dist/</code></p>
        </div>
      </div>
    </section>

    <!-- 特性 -->
    <section class="border-t border-white/5 bg-white/[0.015]">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-violet-300">WHY FUMADOCS</p>
        <h2 class="mt-3 text-center text-3xl font-bold tracking-tight sm:text-4xl">为文档而生，为扩展而设计</h2>
        <p class="mx-auto mt-3 max-w-2xl text-center text-zinc-400">无头 Core + 精美 UI 分层架构：每一层都是独立库，按需组合，绝不锁死。</p>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            features.map((f) => (
              <article class="glass rounded-2xl p-6 transition hover:bg-white/[0.06]">
                <p class="text-[11px] font-semibold tracking-widest text-zinc-500">{f.en}</p>
                <h3 class="mt-2 text-lg font-semibold">{f.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-zinc-400">{f.desc}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 架构分层 -->
    <section class="mx-auto max-w-6xl px-5 py-16">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-300">ARCHITECTURE</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight">四层组合，一次组合</h2>
          <p class="mt-4 leading-relaxed text-zinc-400">
            从无头逻辑到默认主题，从内容源到 CLI 脚手架 —— 看懂每一层如何协作，完全掌控渲染与路由。
            本站即为最佳实践：Astro 负责路由与静态生成，Fumadocs 负责文档层。
          </p>
          <a href="/docs/what-is-fumadocs" class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-blue-300 hover:underline">
            深入理解设计理念 <span aria-hidden="true">→</span>
          </a>
        </div>
        <ol class="space-y-3">
          {
            layers.map((l, i) => (
              <li class="glass flex items-center gap-4 rounded-2xl p-5">
                <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-violet-500/30 to-blue-500/30 text-sm font-bold">
                  {i + 1}
                </span>
                <div class="min-w-0 flex-1">
                  <p class="font-semibold">{l.name}</p>
                  <p class="mt-0.5 text-sm text-zinc-400">{l.desc}</p>
                </div>
                <span class="rounded-full border border-white/10 px-2.5 py-1 text-[11px] font-medium tracking-wider text-zinc-400">{l.tag}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 文档目录 -->
    <section class="border-t border-white/5">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-300">DOCUMENTATION</p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight">中文文档目录</h2>
            <p class="mt-2 text-zinc-400">从快速开始到 UI 定制、搜索、国际化与部署，全部翻译自官方站 fumadocs.dev。</p>
          </div>
          <a href="/docs/" class="rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-zinc-950 hover:bg-zinc-200">
            全部文档 →
          </a>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            docSections.map((s) => (
              <a href={s.href} class="group glass rounded-2xl p-6 transition hover:bg-white/[0.06]">
                <p class="text-lg font-semibold group-hover:text-blue-200">{s.title}</p>
                <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">{s.desc}</p>
                <p class="mt-4 text-sm text-blue-300">阅读 ↗</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 快速开始三步 -->
    <section class="border-t border-white/5 bg-gradient-to-b from-white/[0.02] to-transparent">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <h2 class="text-center text-3xl font-bold tracking-tight">三步，拥有自己的文档站</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          <article class="text-center">
            <p class="mx-auto grid size-12 place-items-center rounded-full bg-violet-500/20 text-lg font-bold text-violet-200">1</p>
            <h3 class="mt-4 font-semibold">脚手架</h3>
            <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-zinc-400">运行 <code class="rounded bg-white/10 px-1.5 py-0.5 text-zinc-200">bunx create-fumadocs-app</code> 选择 Astro 模板。</p>
          </article>
          <article class="text-center">
            <p class="mx-auto grid size-12 place-items-center rounded-full bg-blue-500/20 text-lg font-bold text-blue-200">2</p>
            <h3 class="mt-4 font-semibold">写内容</h3>
            <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-zinc-400">在 <code class="rounded bg-white/10 px-1.5 py-0.5 text-zinc-200">content/docs</code> 新建 MDX，配置 <code class="rounded bg-white/10 px-1.5 py-0.5 text-zinc-200">meta.json</code> 组织侧边栏。</p>
          </article>
          <article class="text-center">
            <p class="mx-auto grid size-12 place-items-center rounded-full bg-emerald-500/20 text-lg font-bold text-emerald-200">3</p>
            <h3 class="mt-4 font-semibold">部署</h3>
            <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-zinc-400"><code class="rounded bg-white/10 px-1.5 py-0.5 text-zinc-200">bun run build</code> 生成 <code class="rounded bg-white/10 px-1.5 py-0.5 text-zinc-200">dist/</code>，一键托管 GitHub Pages / Vercel。</p>
          </article>
        </div>
        <div class="mt-10 text-center">
          <a href="/docs/" class="inline-block rounded-full bg-white px-8 py-4 text-sm font-semibold text-zinc-950 shadow-xl shadow-white/10 hover:bg-zinc-200">
            开始快速开始教程 →
          </a>
        </div>
      </div>
    </section>

    <!-- 页脚 -->
    <footer class="border-t border-white/10">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 py-10 text-sm text-zinc-500 sm:flex-row">
        <p>© 2025 Fumadocs 中文文档 · 翻译自 <a class="underline-offset-4 hover:text-zinc-300 hover:underline" href="https://fumadocs.dev" target="_blank" rel="noreferrer">fumadocs.dev</a> · MIT</p>
        <div class="flex gap-4">
          <a href={docsRoute} class="hover:text-zinc-300">文档</a>
          <a href={githubUrl} class="hover:text-zinc-300" target="_blank" rel="noreferrer">GitHub</a>
          <a href="/docs/integrations/llms" class="hover:text-zinc-300">LLMs</a>
        </div>
      </div>
    </footer>
  </main>
</Layout>

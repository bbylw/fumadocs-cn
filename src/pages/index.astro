---
import type { ShikiTransformer } from 'shiki';
import '@/styles/landing.css';
import Layout from '@/layouts/Layout.astro';
import { LandingPage } from '@/components/landing/LandingPage';
import { summary } from '@/components/landing/content';
import { loadInks } from '@/components/landing/sections/style/presets';
import { INSTALL_TABS, TWOSLASH_SNIPPET } from '@/components/landing/sections/write/data';
import { BEFORE, EDIT_LINE, SOURCE } from '@/components/landing/sections/automate/data';
import { getProofMetrics } from '@/components/landing/sections/proof/data';
import { highlightCode } from '@/lib/shiki';

function excerptTransformer(hasEdit: boolean): ShikiTransformer {
  return {
    line(node, line) {
      const i = line - 1;
      const last = hasEdit ? EDIT_LINE + 1 : EDIT_LINE;
      if (i >= EDIT_LINE - 1 && i <= last) {
        node.properties['data-excerpt'] = '';
      }
    },
  };
}

const [table, installTabs, rawTwoslash, sourceHtml, includedBeforeHtml, includedAfterHtml, metrics] =
  await Promise.all([
    loadInks(),
    Promise.all(
      INSTALL_TABS.map(async (tab) => ({
        label: tab.label,
        html: await highlightCode(tab.code, 'bash'),
      })),
    ),
    highlightCode(TWOSLASH_SNIPPET, 'ts'),
    highlightCode(SOURCE, 'tsx'),
    highlightCode(BEFORE, 'tsx', [excerptTransformer(false)]),
    highlightCode(SOURCE, 'tsx', [excerptTransformer(true)]),
    getProofMetrics(),
  ]);

const completionPopup =
  '<span class="twoslash-completion-cursor"><ul class="twoslash-completion-list" role="listbox"><li data-active="true"><span>getPage</span></li><li><span>getPages</span></li><li><span>getPageTree</span></li><li><span>generateParams</span></li></ul></span>';
const twoslashHtml = rawTwoslash.replace('getP', `getP${completionPopup}`);
---

<Layout
  landing
  title="Fumadocs — 数秒内构建更好的 React 文档框架"
  description={summary}
  image="/banner.png"
>
  <LandingPage
    client:load
    pathname={Astro.url.pathname}
    params={Astro.params}
    table={table}
    writeCode={{ installTabs, twoslashHtml }}
    automateCode={{ sourceHtml, includedBeforeHtml, includedAfterHtml }}
    metrics={metrics}
  />
</Layout>

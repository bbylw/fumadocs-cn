---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { Docs } from '@/components/docs';
import Layout from '@/layouts/Layout.astro';
import { buildGraph } from '@/lib/build-graph';
import { getPageImageUrl, gitConfig } from '@/lib/shared';
import { createPageSlotComponents, source } from '@/lib/source';

export const prerender = true;

export const getStaticPaths = (() => {
  return source.getPages().map((page) => ({
    params: { slug: decodeURI(page.slugs.join('/')) || undefined },
    props: { page },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const { body: Content, toc } = await page.data.load();
const serializedTree = await source.serializePageTree(source.getPageTree());
const data = page.data as {
  title: string;
  description?: string;
  preview?: string;
  lastModified?: Date | string;
};
const graph = data.preview === 'graphView' ? await buildGraph() : undefined;
const pageComponents = createPageSlotComponents(page);
---

<Layout
  title={data.title}
  description={data.description}
  image={getPageImageUrl(page).url}
>
  <Docs
    client:load
    transition:persist="docs"
    pathname={Astro.url.pathname}
    params={Astro.params}
    tree={serializedTree}
    title={data.title}
    description={data.description}
    toc={toc}
    markdownUrl={`${page.url}.md`}
    githubUrl={`https://github.com/${gitConfig.user}/${gitConfig.repo}/blob/${gitConfig.branch}/content/docs/${encodeURI(page.path)}`}
    lastModified={data.lastModified ? new Date(data.lastModified).toISOString() : undefined}
    preview={data.preview}
    graph={graph}
  >
    <Content components={pageComponents} />
  </Docs>
</Layout>

---
import '@/styles/story.css';

interface Props {
  title?: string;
}

const { title = 'Fumadocs 实时预览' } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        var media = matchMedia('(prefers-color-scheme: dark)');
        function syncScheme() {
          var meta = document.querySelector('meta[name="color-scheme"]');
          var stored = null;
          try {
            stored = localStorage.getItem('theme');
          } catch {}
          var isDark = stored === 'dark' || (stored !== 'light' && media.matches);
          document.documentElement.classList.toggle('dark', isDark);
          if (meta) {
            meta.setAttribute(
              'content',
              stored === 'dark' ? 'dark' : stored === 'light' ? 'light' : 'light dark',
            );
          }
        }
        syncScheme();
        window.addEventListener('storage', syncScheme);
        media.addEventListener('change', syncScheme);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <slot />
  </body>
</html>
